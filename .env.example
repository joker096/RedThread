# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: HTTPS origin used to create email account-action links.
# Leave blank until Vow has a real domain; production deployment must not use a placeholder.
APP_URL=

# Express API and PostgreSQL (local development)
API_PORT=3001
# Native Android/iOS build-time API origin. Set only to the real HTTPS API origin; blank means fail closed at runtime.
VITE_API_BASE_URL=
# Optional verified HTTPS App/Universal Link host. Leave blank until a Vow domain is selected.
VOW_APP_LINK_HOST=
VITE_APP_LINK_HOST=
APP_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://vow_user:change_me@localhost:5432/vow_app
# Enable TLS only when required by your managed database; certificate verification stays enabled.
PGSSL=false

# Privacy-first automated screening.
# Default: deterministic local rules only, no external AI service.
# Optional: install Ollama on this SAME server and pull a local model, e.g. qwen2.5:3b.
# Model inference is hard-coded to http://127.0.0.1:11434; no remote URL setting exists.
LOCAL_AI_ENABLED=false
LOCAL_AI_MODEL=qwen2.5:3b

# Account recreation protection after deletion (90 days).
# Generate once with: openssl rand -hex 32. Keep stable across deployments;
# rotating or losing this key makes existing keyed restrictions unrecognizable.
# This is a pseudonymization key, not an anonymization mechanism.
ACCOUNT_REUSE_HMAC_KEY=

# Email verification and password recovery (Resend API)
# In production verification is required unless EMAIL_VERIFICATION_REQUIRED=false.
EMAIL_VERIFICATION_REQUIRED=
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=
# APP_URL is used for one-time email links. Keep it blank until a real HTTPS domain is selected.

# External off-host privacy ledger. Leave blank until the Worker/D1 is provisioned and verified.
# Production privacy-sensitive mutations fail closed when these are not configured.
PRIVACY_RECOVERY_LEDGER_URL=
PRIVACY_RECOVERY_LEDGER_HMAC_SECRET=
PRIVACY_RECOVERY_LEDGER_PSEUDONYM_KEY=

# Private profile-photo storage. In production, point this to a persistent private volume.
PHOTO_STORAGE_DIR=
VOICE_INTRO_STORAGE_DIR=uploads/private-voice-intros
VOICE_INTRO_PURGE_BATCH_SIZE=100
# Generate a dedicated 32-byte AES-256 key with: openssl rand -hex 32
VOICE_INTRO_ENCRYPTION_KEY=
# Optional versioned keyring JSON, e.g. {"key-2026-01":"<64 hex chars>"}.
# Keep all keys needed to decrypt existing recordings; select one active key ID.
VOICE_INTRO_KEYRING=
VOICE_INTRO_ACTIVE_KEY_ID=
# Migration is a manually invoked one-shot operation; never enable it as a background service by default.
VOICE_INTRO_MIGRATION_ENABLED=false
VOICE_INTRO_MIGRATION_JOURNAL_ID=
VOICE_INTRO_MIGRATION_WORKER_ID=

# Gift recipient address vault. Generate with: openssl rand -base64 32
# Store only in the deployment secret manager; never commit a real key.
# The current branch provides the AES-256-GCM primitive/schema, not a live address-entry API.
GIFT_ADDRESS_VAULT_KEY=
# Optional rotation-ready keyring JSON: {"2026-01":"<base64 32-byte key>","2026-02":"<base64 32-byte key>"}.
GIFT_ADDRESS_VAULT_KEYRING=
GIFT_ADDRESS_VAULT_ACTIVE_KEY_VERSION=

# Optional free photo triage via a vision model running locally in Ollama (no third-party image upload).
# Install a compatible vision model locally first; ambiguous results stay pending for moderator review.
PHOTO_AI_ENABLED=false
PHOTO_AI_MODEL=llava:7b

# Paddle Billing — keep sandbox enabled until end-to-end checks pass.
# API key and notification signing secret are server-only; never use VITE_ prefixes for them.
PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_CLIENT_TOKEN=
PADDLE_PRICE_ID_1MONTH=
PADDLE_PRICE_ID_3MONTHS=
PADDLE_PRICE_ID_LIFETIME=

# Didit identity verification — Live requires an explicit environment/key confirmation and a monthly Vow-side quota guard.
# Create a separate Didit Sandbox application, KYC workflow and V3 webhook destination.
DIDIT_ENVIRONMENT=sandbox
# Set true only after confirming the selected Didit application and key are Sandbox in the console.
DIDIT_SANDBOX_KEY_CONFIRMED=false
# Live checks require a separate explicit opt-in; the first 500/month are advertised free, further checks may be billed.
DIDIT_LIVE_KEY_CONFIRMED=false
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
DIDIT_APPLICATION_ID=
DIDIT_WEBHOOK_SECRET=
# Optional old signing secret during Didit's 24-hour webhook secret rotation overlap.
DIDIT_WEBHOOK_SECRET_PREVIOUS=

# L3 approval expiry worker (authorization also checks expires_at synchronously).
IDENTITY_L3_EXPIRY_BATCH_SIZE=100

# L3 is fail-closed until the full upload, moderation and purge lifecycle is enabled.
IDENTITY_L3_ENABLED=false

# L3 video storage encryption key. Generate with: openssl rand -hex 32
# Keep this server-side secret in the deployment secret manager; never reuse the photo key.
IDENTITY_L3_ENCRYPTION_KEY=

# Optional Google Identity Services web client ID (same-origin GIS popup flow).
# Configure only the Web application OAuth client ID; no client secret is used.
GOOGLE_CLIENT_ID=
