# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL=https://example.com

# Express API and PostgreSQL (local development)
API_PORT=3001
APP_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://vow_user:change_me@localhost:5432/vow_app
# Enable TLS only when required by your managed database; certificate verification stays enabled.
PGSSL=false

# Privacy-first automated screening.
# Default: deterministic local rules only, no external AI service.
# Optional: install Ollama on this SAME server and pull a local model, e.g. qwen2.5:3b.
# Model inference is hard-coded to http://127.0.0.1:11434; no remote URL setting exists.
LOCAL_AI_ENABLED=false
LOCAL_AI_MODEL=qwen2.5:3b

# Email verification and password recovery (Resend API)
# In production verification is required unless EMAIL_VERIFICATION_REQUIRED=false.
EMAIL_VERIFICATION_REQUIRED=
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM="Vow <noreply@example.com>"
# Public web app URL above is used in single-use email links; set it to the deployed HTTPS origin.

# Private profile-photo storage. In production, point this to a persistent private volume.
PHOTO_STORAGE_DIR=

# Optional free photo triage via a vision model running locally in Ollama (no third-party image upload).
# Install a compatible vision model locally first; ambiguous results stay pending for moderator review.
PHOTO_AI_ENABLED=false
PHOTO_AI_MODEL=llava:7b

# Stripe: create matching prices in the Stripe dashboard and add a webhook endpoint at /api/billing/webhook.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_1MONTH=
STRIPE_PRICE_ID_3MONTHS=
STRIPE_PRICE_ID_LIFETIME=
